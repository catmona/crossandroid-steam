<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the Steam sign-in token out of cloud backups and device transfers (Android 12 and up). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="steam.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="steam.xml" />
    </device-transfer>
</data-extraction-rules>
