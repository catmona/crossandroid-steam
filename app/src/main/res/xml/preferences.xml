<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        android:title="@string/pref_category_general">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="true"
            android:key="vibration_on_rumble"
            android:summary="@string/vibration_on_rumble_summary"
            android:title="@string/vibration_on_rumble_title" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="true"
            android:key="gapless_music"
            android:summary="@string/gapless_music_summary"
            android:title="@string/gapless_music_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        android:title="@string/pref_category_graphics">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="true"
            android:key="pixelated_scaling"
            android:summary="@string/pixelated_scaling_summary"
            android:title="@string/pixelated_scaling_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_category_overlay_controls"
        app:iconSpaceReserved="false"
        android:title="@string/pref_category_overlay_controls">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="true"
            android:key="switch_layout_automatically"
            android:summary="@string/switch_layout_automatically_summary"
            android:title="@string/switch_layout_automatically" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="true"
            android:key="disable_overlay_cutscenes"
            android:summary="@string/disable_overlay_cutscenes_automatically_summary"
            android:title="@string/disable_overlay_cutscenes" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="false"
            android:key="force_virtual"
            app:summary="@string/force_virtual_summary"
            app:title="@string/force_virtual_title" />

        <de.radicalfishgames.crosscode.preferences.SliderPreference
            android:defaultValue="0"
            android:key="overlay_transparency"
            android:max="100"
            app:showSliderValue="true"
            app:summary="@string/overlay_transparency_summary"
            app:title="@string/overlay_transparency_title" />

        <de.radicalfishgames.crosscode.preferences.SliderPreference
            android:defaultValue="5"
            android:key="overlay_scale_factor"
            android:max="10"
            app:summary="@string/overlay_size_summary"
            app:title="@string/overlay_size_title" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="true"
            android:key="always_sprint"
            android:summary="@string/always_sprint_summary"
            android:title="@string/always_sprint_title" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="false"
            android:key="disable_swipe_dash"
            android:summary="@string/disable_swipe_dash_summary"
            android:title="@string/disable_swipe_dash_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        android:title="@string/pref_category_steam">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/pref_widget_material_switch"
            android:defaultValue="true"
            android:key="steam_achievement_popups"
            android:summary="@string/steam_achievement_popups_summary"
            android:title="@string/steam_achievement_popups_title" />

    </PreferenceCategory>
</PreferenceScreen>
