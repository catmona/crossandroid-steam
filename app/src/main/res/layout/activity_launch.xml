<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/launch_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/launch_button"
            android:minWidth="280dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/launch_game"
            app:layout_constraintBottom_toTopOf="@+id/browse_mods_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.42"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/mounting_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:indeterminate="true"
            app:indicatorSize="24dp"
            app:trackThickness="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/launch_button"
            app:layout_constraintStart_toEndOf="@+id/launch_button"
            app:layout_constraintTop_toTopOf="@+id/launch_button" />

        <Button
            android:id="@+id/browse_mods_button"
            style="@style/Widget.App.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/browse_mods_button"
            app:layout_constraintBottom_toTopOf="@+id/preferences_button"
            app:layout_constraintEnd_toEndOf="@+id/launch_button"
            app:layout_constraintStart_toStartOf="@+id/launch_button"
            app:layout_constraintTop_toBottomOf="@+id/launch_button" />

        <Button
            android:id="@+id/preferences_button"
            style="@style/Widget.App.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/preferences"
            app:layout_constraintBottom_toTopOf="@+id/import_saves_button"
            app:layout_constraintEnd_toEndOf="@+id/launch_button"
            app:layout_constraintStart_toStartOf="@+id/launch_button"
            app:layout_constraintTop_toBottomOf="@+id/browse_mods_button" />

        <Button
            android:id="@+id/import_saves_button"
            style="@style/Widget.App.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/import_saves_button"
            app:layout_constraintBottom_toTopOf="@+id/export_saves_button"
            app:layout_constraintEnd_toEndOf="@+id/launch_button"
            app:layout_constraintStart_toStartOf="@+id/launch_button"
            app:layout_constraintTop_toBottomOf="@+id/preferences_button" />

        <Button
            android:id="@+id/export_saves_button"
            style="@style/Widget.App.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/export_saves_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/launch_button"
            app:layout_constraintStart_toStartOf="@+id/launch_button"
            app:layout_constraintTop_toBottomOf="@+id/import_saves_button" />

        <Button
            android:id="@+id/about_button"
            style="@style/Widget.App.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/about_app"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ViewStub
        android:id="@+id/setup_container_stub"
        android:inflatedId="@+id/setup_container"
        android:layout="@layout/guide_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</FrameLayout>
